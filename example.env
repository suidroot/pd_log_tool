# Django settings
SECRET_KEY="super secret key"
# Map tile provider: osm | carto-light | carto-dark (default: carto-light)
MAP_TILE_PROVIDER=carto-light

# Celery broker (Redis) — dev default is localhost, prod default is redis://redis:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

# MySQL settings
MYSQL_ROOT_PASSWORD=exmaplepassword
MYSQL_DATABASE=dbname
MYSQL_USER=dbuser
MYSQL_PASSWORD=dbuser password
DB_HOST=db
DB_PORT=3306